# Copy to .env for local runs, or paste into the Render Environment tab.
# Never commit real values.

# --- Where the journal lives (on the persistent disk in production) ---
GREENHOUR_HOME=/opt/data/greenhour

# --- Home coordinates for the nudge (Open-Meteo needs no key) ---
GREENHOUR_LAT=
GREENHOUR_LON=
GREENHOUR_TZ=

# --- Agent loop: the model Hermes runs on, and the extractor baseline ---
OPENROUTER_API_KEY=
GREENHOUR_AGENT_MODEL=qwen/qwen3-4b:free

# --- Speech to text (hosted open-weight Whisper) ---
GROQ_API_KEY=

# --- Fine-tuned adapter, printed by train/train_tinker.py ---
TINKER_API_KEY=
TINKER_MODEL_PATH=
TINKER_BASE_MODEL=Qwen/Qwen3.5-4B

# --- Hermes' Telegram gateway ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Optional: publish the public streak snapshot ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- Optional: let the agent inspect its own Render service (least privilege!) ---
RENDER_MCP_API_KEY=
